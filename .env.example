# Wunschdruck-Konfiguration — Kopie als .env ablegen und anpassen.

# Moonraker des Druckers (Pflicht fuer den Druckbetrieb; ohne = reiner Slice-Modus)
MOONRAKER_URL=http://192.168.x.x:7125

# Home Assistant (alles OPTIONAL — ohne HA keine Meldungen/Steckdosen-Automatik)
#HA_URL=http://192.168.x.x:8123
#HA_TOKEN=eyJ...   # Langlebiges Zugriffstoken
#HA_NOTIFY=notify.mein_telegram
#HA_SWITCH=switch.3d_drucker
#HA_WARTUNGSRIEGEL=input_boolean.drucker_wartung

# Oberflaechensprache: de oder en
SPRACHE_STANDARD=de

# Wartezeiten (Sekunden)
#EINSCHALT_TIMEOUT_S=300
#SLICE_TIMEOUT_S=900

# Optional: Thingiverse in der App durchsuchen und Modelle direkt laden.
# App-Token: thingiverse.com/developers -> "Create an App" -> App Token
THINGIVERSE_TOKEN=
