{
  "name": "Wunschdruck",
  "short_name": "Wunschdruck",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f2ee",
  "theme_color": "#b3591f",
  "icons": [
    {"src": "/statisch/symbol-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/statisch/symbol-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/statisch/symbol-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "/teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{
        "name": "datei",
        "accept": [".stl", ".3mf", "model/stl", "model/3mf",
                   "application/vnd.ms-package.3dmanufacturing-3dmodel+xml",
                   "application/octet-stream"]
      }]
    }
  }
}
